<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox maxHeight="Infinity" maxWidth="Infinity" style="-fx-background-color:#F4F4F6;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="controller.ProfileController">

    <HBox alignment="CENTER_LEFT" maxWidth="Infinity" prefHeight="56" spacing="12" styleClass="navbar">
        <padding><Insets bottom="0" left="20" right="20" top="0" /></padding>
        <Button onAction="#handleBack" style="-fx-text-fill:#AAAAAA;" styleClass="btn-ghost" text="← Каталог" />
        <Label styleClass="nav-brand" />
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#handleOrders" styleClass="nav-link" text="Мои заказы" />
        <Button onAction="#handleLogout" styleClass="btn-danger-small" text="Выйти" />
    </HBox>

    <HBox spacing="0" VBox.vgrow="ALWAYS">

        <VBox maxWidth="280" minWidth="220" style="-fx-background-color:#FFFFFF; -fx-border-color:transparent #EEEEEE transparent transparent; -fx-border-width:0 1 0 0;">
            <padding><Insets bottom="36" left="20" right="20" top="36" /></padding>
            <VBox alignment="CENTER" spacing="18">
                <VBox alignment="CENTER" prefHeight="80" prefWidth="80" styleClass="profile-avatar">
                    <Label style="-fx-font-size:34px;" text="👤" />
                </VBox>
                <VBox alignment="CENTER" spacing="4">
                    <Label fx:id="usernameLabel" styleClass="profile-name" />
                    <Label fx:id="emailLabel" styleClass="profile-email" />
                    <Label fx:id="roleLabel" style="-fx-font-size:11px; -fx-font-weight:bold;" />
                </VBox>
                <Separator />
                <VBox maxWidth="Infinity" onMouseClicked="#handleOrdersClick" spacing="5" style="-fx-cursor:hand;" styleClass="stat-card">
                    <Label styleClass="heading-sm" text="📦  Мои заказы" />
                    <Label styleClass="label-muted" text="История всех покупок" />
                </VBox>
            </VBox>
        </VBox>

        <ScrollPane fitToWidth="true" style="-fx-background-color:transparent; -fx-border-color:transparent;" HBox.hgrow="ALWAYS">
            <VBox spacing="20" style="-fx-background-color:#F4F4F6;">
                <padding><Insets bottom="40" left="32" right="40" top="32" /></padding>

                <Label styleClass="heading-lg" text="Настройки профиля" />

                <VBox spacing="16" styleClass="profile-section-card">
                    <Label styleClass="heading-sm" text="Личная информация" />
                    <Separator />
                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label styleClass="login-input-label" text="ИМЯ" />
                            <TextField fx:id="firstNameField" promptText="Введите имя" />
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label styleClass="login-input-label" text="ФАМИЛИЯ" />
                            <TextField fx:id="lastNameField" promptText="Введите фамилию" />
                        </VBox>
                    </HBox>
                    <VBox spacing="6">
                        <Label styleClass="login-input-label" text="ТЕЛЕФОН" />
                        <TextField fx:id="phoneField" maxWidth="320" promptText="+7 (XXX) XXX-XX-XX" />
                    </VBox>
                    <Label fx:id="profileErrorLabel" styleClass="text-error" wrapText="true" />
                    <Button onAction="#handleSave" prefHeight="42" prefWidth="160" styleClass="btn-primary" text="Сохранить" />
                </VBox>

                <VBox spacing="16" styleClass="profile-section-card">
                    <Label styleClass="heading-sm" text="Изменить email" />
                    <Separator />
                    <VBox spacing="6">
                        <Label styleClass="login-input-label" text="НОВЫЙ EMAIL" />
                        <TextField fx:id="newEmailField" maxWidth="400" promptText="Введите новый email" />
                    </VBox>
                    <Label fx:id="emailErrorLabel" styleClass="text-error" wrapText="true" />
                    <Label fx:id="emailSuccessLabel" styleClass="text-success" wrapText="true" />
                    <Button onAction="#handleUpdateEmail" prefHeight="42" prefWidth="180" styleClass="btn-outline" text="Обновить email" />
                </VBox>

                <VBox fx:id="cardsSection" spacing="16" styleClass="profile-section-card">
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="heading-sm" text="Карты для оплаты" />
                    </HBox>
                    <Separator />

                    <VBox fx:id="cardsBox" spacing="10" />
                    <Label fx:id="noCardsLabel" styleClass="label-muted" text="Нет сохранённых карт" />

                    <VBox spacing="14" style="-fx-background-color:#F8F8FA; -fx-border-color:#E8E8F0; -fx-border-width:1.5;                                  -fx-border-radius:12; -fx-background-radius:12; -fx-padding:20;">
                        <Label styleClass="heading-sm" text="Привязать новую карту" />

                        <VBox spacing="6">
                            <Label styleClass="login-input-label" text="НОМЕР КАРТЫ" />
                            <TextField fx:id="cardNumberField" promptText="0000  0000  0000  0000" style="-fx-font-size:16px; -fx-letter-spacing:2; -fx-pref-height:46;" />
                        </VBox>

                        <HBox spacing="16">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label styleClass="login-input-label" text="ИМЯ ДЕРЖАТЕЛЯ" />
                                <TextField fx:id="cardHolderField" promptText="IVAN IVANOV" />
                            </VBox>
                            <VBox maxWidth="120" minWidth="100" spacing="6">
                                <Label styleClass="login-input-label" text="СРОК" />
                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <TextField fx:id="expiryMonthField" promptText="ММ" prefWidth="60" maxWidth="60"/>
                                    <Label text="/" styleClass="label-muted" style="-fx-font-size:16px; -fx-padding:0 2;"/>
                                    <TextField fx:id="expiryYearField" promptText="ГГ" prefWidth="60" maxWidth="60"/>
                                </HBox>
                            </VBox>
                            <VBox maxWidth="100" minWidth="80" spacing="6">
                                <Label styleClass="login-input-label" text="CVV" />
                                <PasswordField fx:id="cvvField" promptText="•••" />
                            </VBox>
                        </HBox>

                        <Label fx:id="cardErrorLabel" styleClass="text-error" wrapText="true" />
                        <Button onAction="#handleAddCard" prefHeight="42" prefWidth="200" styleClass="btn-primary" text="＋  Привязать карту" />
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </HBox>
</VBox>
